  "scoring_logic": {
    "answer_scoring": "每个选项包含 scores 字段。multi_choice 题对所选选项按维度取平均分（避免选 2 项时权重翻倍），最多 2 项。scale_0_7 题使用 score_formula 计算。",
    "normalization": "每个维度分数可做 min-max 或 z-score 标准化；MVP 可直接使用原始分排序。",
    "profile_selection": "对每个 profile_rules 中的 match_formula 计算匹配分，最高分为主画像，第二高为辅助画像。",
    "tie_breaking": [
      "如果 stability 和 risk 同时高，优先选择“稳健就业型”或“复合转型型”，并在报告中提示用户既想稳定又想保留机会。",
      "如果 technical 和 income 同时高，优先选择“技术深耕型”或“高收入冲刺型”。",
      "如果 research 高且 self_learning 相关题偏高，优先选择“研究探索型”。",
      "如果 creative 和 people 同时高，优先选择“创意表达型”或“人际影响型”。"
    ],
    "confidence": {
      "high": "主画像分数比第二画像高 20% 以上",
      "medium": "主画像分数比第二画像高 10%–20%",
      "low": "主画像分数比第二画像高不到 10%，建议展示双画像"
    }
  },
