{
  "test_meta": {
    "id": "major_choice_profile_test_v1",
    "title": "3分钟生成你的专业选择画像",
    "subtitle": "结合兴趣、学习方式、就业价值观和现实约束，生成你的专业方向建议，并匹配真实学长学姐/从业者。",
    "version": "1.0.0",
    "language": "zh-CN",
    "estimated_time_minutes": 3,
    "disclaimer": "本测试用于专业选择前的自我探索和方向筛选，不应作为最终志愿填报或录取决策依据。"
  },
  "score_dimensions": {
    "stability": {
      "label": "就业稳定",
      "description": "重视稳定就业、确定性、家庭接受度、体制或长期安全感。"
    },
    "income": {
      "label": "收入上限",
      "description": "重视高收入、行业红利、竞争机会和长期收入成长空间。"
    },
    "technical": {
      "label": "技术强度",
      "description": "能接受数学、代码、工程、实验、算法或长期技能积累。"
    },
    "people": {
      "label": "人际沟通",
      "description": "擅长表达、组织、协调、说服、服务或影响他人。"
    },
    "creative": {
      "label": "创造表达",
      "description": "偏好设计、内容、传媒、产品、审美、表达和创意产出。"
    },
    "research": {
      "label": "科研深造",
      "description": "愿意长期钻研、读研读博、做实验、做研究或探索未知问题。"
    },
    "risk": {
      "label": "风险承受",
      "description": "能接受行业波动、路径不确定、竞争压力和试错成本。"
    },
    "city": {
      "label": "城市依赖",
      "description": "重视城市平台、实习机会、就业资源和行业聚集度。"
    },
    "public_sector": {
      "label": "体制规划",
      "description": "偏向考公、编制、事业单位、教师、法学、公共管理等稳定路径。"
    },
    "interdisciplinary": {
      "label": "复合转型",
      "description": "兴趣广、希望保留转向空间，适合交叉学科或复合型路径。"
    }
  },
