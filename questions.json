[
  { "id": "EI_01", "text": "长时间社交后，我通常会感到更有精神。", "dimension": "EI", "facet": "energy_recovery", "polarity": "E", "weight": 0.8 },
  { "id": "EI_02", "text": "独处一段时间会让我更快恢复状态。", "dimension": "EI", "facet": "energy_recovery", "polarity": "I", "weight": 1.0 },
  { "id": "EI_03", "text": "周末我更倾向安排与朋友见面而不是自己待着。", "dimension": "EI", "facet": "energy_recovery", "polarity": "E", "weight": 1.3 },
  { "id": "EI_04", "text": "在陌生场合中，我会主动开启话题。", "dimension": "EI", "facet": "social_preference", "polarity": "I", "weight": 1.5 },
  { "id": "EI_05", "text": "我在小圈子深聊时比在大群体里更自在。", "dimension": "EI", "facet": "social_preference", "polarity": "E", "weight": 0.8 },
  { "id": "EI_06", "text": "结识新朋友通常让我感到兴奋。", "dimension": "EI", "facet": "social_preference", "polarity": "I", "weight": 1.0 },
  { "id": "EI_07", "text": "做决定时，我会先和他人讨论再行动。", "dimension": "EI", "facet": "decision_style", "polarity": "E", "weight": 1.3 },
  { "id": "EI_08", "text": "面对重大选择，我更依赖独立思考后再表达。", "dimension": "EI", "facet": "decision_style", "polarity": "I", "weight": 1.5 },
  { "id": "EI_09", "text": "我倾向边说边想，通过交流理清思路。", "dimension": "EI", "facet": "decision_style", "polarity": "E", "weight": 0.8 },
  { "id": "EI_10", "text": "节奏快、变化多的环境更能激发我。", "dimension": "EI", "facet": "stimulation_preference", "polarity": "I", "weight": 1.0 },
  { "id": "EI_11", "text": "安静稳定的环境更有助于我发挥。", "dimension": "EI", "facet": "stimulation_preference", "polarity": "E", "weight": 1.3 },
  { "id": "EI_12", "text": "我喜欢在多人互动中寻找灵感。", "dimension": "EI", "facet": "stimulation_preference", "polarity": "I", "weight": 1.5 },

  { "id": "SN_13", "text": "我处理任务时会优先关注事实和细节。", "dimension": "SN", "facet": "detail_attention", "polarity": "S", "weight": 0.8 },
  { "id": "SN_14", "text": "我常先把握整体趋势，再回头看细节。", "dimension": "SN", "facet": "detail_attention", "polarity": "N", "weight": 1.0 },
  { "id": "SN_15", "text": "相比概念设想，我更看重可验证的信息。", "dimension": "SN", "facet": "detail_attention", "polarity": "S", "weight": 1.3 },
  { "id": "SN_16", "text": "学习新内容时，我偏好步骤清晰的示例。", "dimension": "SN", "facet": "learning_preference", "polarity": "N", "weight": 1.5 },
  { "id": "SN_17", "text": "我更容易被抽象模型和概念框架吸引。", "dimension": "SN", "facet": "learning_preference", "polarity": "S", "weight": 0.8 },
  { "id": "SN_18", "text": "我倾向先掌握具体做法，再理解背后原理。", "dimension": "SN", "facet": "learning_preference", "polarity": "N", "weight": 1.0 },
  { "id": "SN_19", "text": "我更关心眼前可执行的现实安排。", "dimension": "SN", "facet": "time_focus", "polarity": "S", "weight": 1.3 },
  { "id": "SN_20", "text": "我经常思考未来可能出现的新机会。", "dimension": "SN", "facet": "time_focus", "polarity": "N", "weight": 1.5 },
  { "id": "SN_21", "text": "我习惯根据过去经验做稳妥判断。", "dimension": "SN", "facet": "time_focus", "polarity": "S", "weight": 0.8 },
  { "id": "SN_22", "text": "面对问题时，我更愿意采用成熟可行的方法。", "dimension": "SN", "facet": "creativity_mode", "polarity": "N", "weight": 1.0 },
  { "id": "SN_23", "text": "我喜欢尝试不寻常、可能性更高的新点子。", "dimension": "SN", "facet": "creativity_mode", "polarity": "S", "weight": 1.3 },
  { "id": "SN_24", "text": "我做方案时会先确保细节落地，再谈创新。", "dimension": "SN", "facet": "creativity_mode", "polarity": "N", "weight": 1.5 },

  { "id": "TF_25", "text": "做选择时，我会优先考虑逻辑一致性。", "dimension": "TF", "facet": "decision_criteria", "polarity": "T", "weight": 0.8 },
  { "id": "TF_26", "text": "我会优先考虑对他人感受的影响。", "dimension": "TF", "facet": "decision_criteria", "polarity": "F", "weight": 1.0 },
  { "id": "TF_27", "text": "即使结论不受欢迎，我也倾向坚持客观判断。", "dimension": "TF", "facet": "decision_criteria", "polarity": "T", "weight": 1.3 },
  { "id": "TF_28", "text": "出现分歧时，我更在意讨论是否有理有据。", "dimension": "TF", "facet": "conflict_resolution", "polarity": "F", "weight": 1.5 },
  { "id": "TF_29", "text": "冲突中我通常先维护关系和情绪安全感。", "dimension": "TF", "facet": "conflict_resolution", "polarity": "T", "weight": 0.8 },
  { "id": "TF_30", "text": "我更愿意直接指出问题，而不是先缓和气氛。", "dimension": "TF", "facet": "conflict_resolution", "polarity": "F", "weight": 1.0 },
  { "id": "TF_31", "text": "我希望得到直接、具体、可执行的反馈。", "dimension": "TF", "facet": "feedback_preference", "polarity": "T", "weight": 1.3 },
  { "id": "TF_32", "text": "我更希望反馈方式先体现理解与尊重。", "dimension": "TF", "facet": "feedback_preference", "polarity": "F", "weight": 1.5 },
  { "id": "TF_33", "text": "被指出问题时，只要有依据我能快速接受。", "dimension": "TF", "facet": "feedback_preference", "polarity": "T", "weight": 0.8 },
  { "id": "TF_34", "text": "我判断公平时更看重统一标准。", "dimension": "TF", "facet": "fairness_sense", "polarity": "F", "weight": 1.0 },
  { "id": "TF_35", "text": "我判断公平时更看重个体处境差异。", "dimension": "TF", "facet": "fairness_sense", "polarity": "T", "weight": 1.3 },
  { "id": "TF_36", "text": "决策中我更偏好原则先行而非人情先行。", "dimension": "TF", "facet": "fairness_sense", "polarity": "F", "weight": 1.5 },

  { "id": "JP_37", "text": "我习惯提前规划并按计划推进任务。", "dimension": "JP", "facet": "planning", "polarity": "J", "weight": 0.8 },
  { "id": "JP_38", "text": "我更喜欢保留灵活空间，边做边调整。", "dimension": "JP", "facet": "planning", "polarity": "P", "weight": 1.0 },
  { "id": "JP_39", "text": "明确的时间表会让我更有掌控感。", "dimension": "JP", "facet": "planning", "polarity": "J", "weight": 1.3 },
  { "id": "JP_40", "text": "临时变更计划会让我感到不适。", "dimension": "JP", "facet": "flexibility", "polarity": "P", "weight": 1.5 },
  { "id": "JP_41", "text": "变化通常会让我觉得有新鲜感和机会。", "dimension": "JP", "facet": "flexibility", "polarity": "J", "weight": 0.8 },
  { "id": "JP_42", "text": "我倾向先确定规则，再开始行动。", "dimension": "JP", "facet": "flexibility", "polarity": "P", "weight": 1.0 },
  { "id": "JP_43", "text": "我喜欢把事项分解成清晰步骤再执行。", "dimension": "JP", "facet": "structure_need", "polarity": "J", "weight": 1.3 },
  { "id": "JP_44", "text": "我在开放式任务中往往表现更好。", "dimension": "JP", "facet": "structure_need", "polarity": "P", "weight": 1.5 },
  { "id": "JP_45", "text": "完成任务时，我会先收尾再开启新任务。", "dimension": "JP", "facet": "structure_need", "polarity": "J", "weight": 0.8 },
  { "id": "JP_46", "text": "遇到突发情况时，我更愿意按预案处理。", "dimension": "JP", "facet": "adaptability", "polarity": "P", "weight": 1.0 },
  { "id": "JP_47", "text": "遇到突发情况时，我更愿意现场即兴调整。", "dimension": "JP", "facet": "adaptability", "polarity": "J", "weight": 1.3 },
  { "id": "JP_48", "text": "我更偏好结果可预测、流程稳定的安排。", "dimension": "JP", "facet": "adaptability", "polarity": "P", "weight": 1.5 }
]
